   "data": {
    "bull": [
     {
      "text": "ITC delivers high returns with ROCE of 39% and operating margin of 34.6% on TTM revenue of ₹77,255 Cr and PAT of ₹19,226 Cr.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The company boasts a powerful brand portfolio of over 30 world-class Indian brands reaching nearly 280 million households across India and 70+ countries.",
      "source_ids": [
       "AR:2026:p76"
      ]
     },
     {
      "text": "Balance sheet strength is evident with negligible debt-to-equity of 0.01, providing financial flexibility.",
      "source_ids": [
       "SCR"
      ]
     }
    ],
    "bear": [
     {
      "text": "Growth has been sluggish with 3-year revenue CAGR of only 3.6% and PAT CAGR of 2.6%.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Operating margin has contracted from 36.2% three years ago to 34.6% currently, signaling margin pressure.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Cash conversion is weak with operating cash flow to PAT ratio of just 0.69 over three years, flagged as \"Profits not converting to cash\".",
      "source_ids": [
       "SCR"
      ]
     }
    ]
