   "data": {
    "bull": [
     {
      "text": "ITC delivers a 39% ROCE with a 34.6% operating margin while maintaining a negligible debt-to-equity of 0.03.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The company's 30+ home-grown brands reach nearly 280 million Indian households with annual consumer spend exceeding ₹37,000 crores.",
      "source_ids": [
       "AR:2026:p76",
       "AR:2026:p77",
       "AR:2026:p352"
      ]
     },
     {
      "text": "Cigarettes contribute 45.88% of revenue, providing a high-margin anchor for the diversified FMCG portfolio.",
      "source_ids": [
       "AR:2026:p352"
      ]
     }
    ],
    "bear": [
     {
      "text": "Revenue and PAT growth are sluggish with 3-year CAGRs of only 3.6% and 2.6% respectively.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Profits are not converting to cash, evidenced by a 3-year operating cash flow to PAT ratio of just 0.69.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Operating margin has declined from 36.2% to 34.6% over three years, and the business carries concentration risk with cigarettes at 45.88% of revenue.",
      "source_ids": [
       "SCR",
       "AR:2026:p352"
      ]
     }
    ]
