   "data": {
    "bull": [
     {
      "text": "Revenue and PAT showed strong sequential recovery in recent quarters, with Jun 2026 revenue at ₹2,578 Cr and PAT at ₹345 Cr versus Sep 2025 revenue ₹1,902 Cr and PAT ₹119 Cr.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Balance sheet remains conservative with debt-to-equity of 0.28 and operating cash flow closely tracking PAT (0.99x over 3 years).",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management expects near-full utilization (95-105%) on nitric acid, nitration and hydrogenation assets from the current quarter onwards.",
      "source_ids": [
       "T:2026-02-01:p12"
      ]
     }
    ],
    "bear": [
     {
      "text": "Three-year CAGR shows revenue declining -0.4% and PAT declining -13.5%, with operating margin compressed from 16.2% to 12.5%.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "ROCE is low at 11% and margins are flagged as compressing.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Large capex of ~INR 11,000-11,500 crore planned with significant debt funding (target debt up to INR 8,000-8,500 crore) could pressure returns.",
      "source_ids": [
       "T:2026-08-01:p19",
       "T:2026-05-01:p15"
      ]
     }
    ]
   },
