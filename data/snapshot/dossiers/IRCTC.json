   "data": {
    "bull": [
     {
      "text": "IRCTC delivers strong profitability with 46% ROCE, 31.9% operating margin, and minimal leverage (debt/equity 0.02) alongside 3-year revenue and PAT CAGRs of 13.8% and 11.5% respectively.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management projects tourism revenue to exceed ₹1,000 Cr from ₹890 Cr and aims to restore a segment to ₹150 Cr, signaling growth in high-margin travel and hospitality.",
      "source_ids": [
       "T:2026-08-01:p16",
       "T:2026-08-01:p17"
      ]
     },
     {
      "text": "The IT business's non-convenience fee contribution has already reached 17.2% against a 10% target, demonstrating successful digital monetization beyond expectations.",
      "source_ids": [
       "T:2026-05-01:p12"
      ]
     }
    ],
    "bear": [
     {
      "text": "Management missed its 15% sustainable growth target, delivering only 11.5% over four quarters, while the last four quarters show sequential declines in both revenue (₹1,449 Cr to ₹1,333 Cr) and PAT (₹394 Cr to ₹264 Cr).",
      "source_ids": [
       "T:2026-02-01:p7",
       "SCR"
      ]
     },
     {
      "text": "Operating margin has compressed from 36% three years ago to 31.9% currently, with the screener explicitly flagging margin compression.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Cash conversion remains weak with operating cash flow at only 0.78x PAT over three years, indicating earnings are not translating into cash.",
      "source_ids": [
       "SCR"
      ]
     }
    ]
   },
