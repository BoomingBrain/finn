   "data": {
    "bull": [
     {
      "text": "IRCTC delivers strong profitable growth with TTM revenue of ₹5,425 Cr and PAT of ₹1,392 Cr, compounding at 13.8% and 11.5% CAGR over three years.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The company enjoys high capital efficiency with 46% ROCE, 31.9% operating margin, and negligible debt (D/E 0.02).",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Multiple growth levers exist: tourism revenue rose from ₹745 Cr to ₹890 Cr with management targeting ₹1,000+ Cr, while ~20 Vande Bharat sleeper trains could add ~₹120 Cr in license fees.",
      "source_ids": [
       "T:2026-08-01:p16",
       "T:2026-08-01:p17"
      ]
     }
    ],
    "bear": [
     {
      "text": "Operating margins have compressed from 36% to 31.9% over three years, with the screener explicitly flagging margin compression.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management's 15% sustainable growth target was missed, delivering only 11.5% over the last four quarters.",
      "source_ids": [
       "T:2026-02-01:p7"
      ]
     },
     {
      "text": "The 30% margin aspiration is off track with only 28.2% delivered in the first quarter of the period, and cash conversion remains weak at 0.78x PAT over three years.",
      "source_ids": [
       "T:2026-05-01:p8",
       "SCR"
      ]
     }
    ]
