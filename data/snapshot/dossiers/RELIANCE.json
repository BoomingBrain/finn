   "data": {
    "bull": [
     {
      "text": "Revenue grew at a 6.4% 3-year CAGR to ₹1,123,055 Cr TTM with PAT growing faster at an 8.9% CAGR to ₹88,167 Cr TTM.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Operating margin expanded to 17% from 16.2% three years ago, and operating cash flow covered PAT 2.07x over the last three years.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management expects 4-5% ARPU growth in digital services even without tariff increases.",
      "source_ids": [
       "T:2026-04-01:p28"
      ]
     }
    ],
    "bear": [
     {
      "text": "ROCE remains low at 10% despite the company's scale, and ROE is not reported.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management guides for operating rates at only 80% levels, indicating persistent underutilization of capacity.",
      "source_ids": [
       "T:2026-01-01:p21"
      ]
     },
     {
      "text": "Quarterly PAT fell to ₹20,589 Cr in Mar 2026 from ₹22,290 Cr in Dec 2025 despite revenue rising to ₹294,059 Cr from ₹264,905 Cr.",
      "source_ids": [
       "SCR"
      ]
     }
    ]
