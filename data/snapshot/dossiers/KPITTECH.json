   "data": {
    "bull": [
     {
      "text": "KPIT has delivered a 3-year revenue CAGR of 24.3% and PAT CAGR of 18.1% with a strong ROCE of 26%, low debt-to-equity of 0.21, and operating cash flow to PAT of 1.73x over three years.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management guides for 30% YoY growth in solutions/products and EBITDA margin expansion to 22-24%, with early progress showing 7.6% revenue growth delivered in 2 of 4 quarters and 15.6% EBITDA margin in those quarters.",
      "source_ids": [
       "T:2026-05-01:p17",
       "T:2026-05-01:p18"
      ]
     },
     {
      "text": "Wallet share among top 25 clients grew from 10% to 12% YoY with a target of 15-20%, and the company expects its software footprint to expand from 2 million to 3 million vehicles next year.",
      "source_ids": [
       "T:2026-05-01:p12",
       "T:2026-02-01:p15"
      ]
     }
    ],
    "bear": [
     {
      "text": "Quarterly PAT has been volatile, dropping to ₹116 Cr in Sep 2026 from ₹163 Cr in Mar 2026, while quarterly revenue has plateaued around ₹1.6-1.7K Cr over the last four quarters.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management's EBITDA margin guidance of 20.5-21.2% has only delivered 15.6% in 2 of 4 quarters, and the 30% solutions/products growth target has only achieved 7.6% so far.",
      "source_ids": [
       "T:2026-05-01:p17"
      ]
     },
     {
      "text": "Key strategic targets—50% revenue share from solutions/products, 20% overall growth, and 15-20% wallet share in top 25 clients—remain unverified from reported financials, highlighting execution uncertainty.",
      "source_ids": [
       "T:2026-05-01:p18",
       "T:2026-05-01:p30",
       "T:2026-05-01:p12"
      ]
     }
    ]
