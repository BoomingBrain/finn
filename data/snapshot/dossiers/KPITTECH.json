   "data": {
    "bull": [
     {
      "text": "KPIT has delivered strong historical growth with a 3-year revenue CAGR of 24.3% and PAT CAGR of 18.1%.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The company maintains high profitability with 18.9% operating margin, 26% ROCE, low leverage (0.24 debt/equity), and robust cash conversion (1.73x operating cash flow/PAT over 3 years).",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management targets 30%+ growth in solutions/products, aims to shift that segment from 15% to 60% of revenue in 3 years, and expects EBITDA margins to expand to 22-24%.",
      "source_ids": [
       "T:2026-05-01:p17",
       "T:2026-05-01:p18",
       "T:2026-05-01:p6"
      ]
     }
    ],
    "bear": [
     {
      "text": "Quarterly PAT has been volatile, falling from ₹163 Cr in Mar 2026 to ₹116 Cr in Jun 2026 and ₹121 Cr in Sep 2026 despite revenue remaining around ₹1,675-1,711 Cr.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management's EBITDA margin guidance of 20.5-21.2% has only delivered 15.6% in 2 of 4 quarters, and other targets (30% solutions growth, 60% mix shift, 22-24% EBITDA) remain unverified.",
      "source_ids": [
       "T:2026-05-01:p17",
       "T:2026-05-01:p18",
       "T:2026-05-01:p6"
      ]
     },
     {
      "text": "Operating margin has been flat over 3 years (18.8% to 18.9%) despite 24% revenue CAGR, and the business is concentrated on global mobility OEMs with a risky transition to higher-margin solutions/products.",
      "source_ids": [
       "SCR",
       "AR:2026:p8",
       "T:2026-05-01:p18"
      ]
     }
