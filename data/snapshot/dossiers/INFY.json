   "data": {
    "bull": [
     {
      "text": "Infosys delivers strong profitability with a 23.7% operating margin exceeding its 20-22% guidance, a 40% ROCE, and a low 0.09 debt-to-equity ratio.",
      "source_ids": [
       "SCR",
       "T:2026-10-01:p4"
      ]
     },
     {
      "text": "Revenue and PAT have grown at 3-year CAGRs of 6.8% and 6.9% respectively, with quarterly revenue rising sequentially from ₹45,479 Cr to ₹49,244 Cr over the last four quarters.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The company converts earnings to cash effectively with a 1.15x operating cash flow to PAT ratio over three years, while 95.23% of turnover comes from high-value software and digital services exported globally.",
      "source_ids": [
       "SCR",
       "AR:2026:p143"
      ]
     }
    ],
    "bear": [
     {
      "text": "Management guides only 1-2% revenue growth for the year, a sharp deceleration from the 6.8% 3-year revenue CAGR.",
      "source_ids": [
       "SCR",
       "T:2026-10-01:p36"
      ]
     },
     {
      "text": "Operating margin guidance of 20-22% implies potential compression from the current 23.7% level.",
      "source_ids": [
       "SCR",
       "T:2026-10-01:p4"
      ]
     },
     {
      "text": "The business derives 97.40% of turnover from exports and is concentrated in segments like Financial Services, creating geographic and client concentration risk.",
      "source_ids": [
       "AR:2026:p143",
       "AR:2026:p22"
      ]
     }
    ]
