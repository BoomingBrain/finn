   "data": {
    "bull": [
     {
      "text": "The bank has delivered strong top-line growth with a 3-year revenue CAGR of 18.3% and consistent quarterly revenue expansion from ₹17,507 Cr in Dec 2025 to ₹19,856 Cr in Sep 2026.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Profit after tax has grown steadily each quarter, rising from ₹4,924 Cr in Dec 2025 to ₹5,645 Cr in Sep 2026, supporting a 3-year PAT CAGR of 8.9%.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The ECL transition is expected to have a minimal one-time impact of less than 2% of net worth and only a 12-15 bps ongoing increase in credit costs.",
      "source_ids": [
       "T:2026-08-01:p15"
      ]
     }
    ],
    "bear": [
     {
      "text": "Return on equity stands at a modest 11%, which may limit shareholder returns.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "PAT growth (8.9% CAGR) lags revenue growth (18.3% CAGR) over three years, suggesting margin compression.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The bank faces an expected 12-15 bps increase in credit costs once ECL is fully implemented.",
      "source_ids": [
       "T:2026-08-01:p15"
      ]
     }
