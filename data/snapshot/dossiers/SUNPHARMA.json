   "data": {
    "bull": [
     {
      "text": "The company has delivered consistent 3-year CAGR of 10% in revenue and 10.6% in PAT while expanding operating margin from 26.5% to 28.2% and maintaining ROCE at 21%.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The balance sheet is strong with a low debt-to-equity of 0.04 and robust cash conversion evidenced by operating cash flow to PAT of 1.2x over three years.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management guides for combined revenues of $12.4 billion with two of four quarters already delivered and targets $350 million in cost synergies over the next two to four years.",
      "source_ids": [
       "T:2026-05-01:p7",
       "T:2026-05-01:p9"
      ]
     }
    ],
    "bear": [
     {
      "text": "PAT has declined sequentially from ₹3,381 Cr in Dec 2025 to ₹1,995 Cr in Sep 2026 despite revenue rising to ₹16,199 Cr, signaling margin compression.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Nearly all strategic targets — including business mix shifts (innovative to 27%, branded generics >51%, generics 15%, biosimilars 6%), geographic mix (US 27%, emerging markets 29%, India 17%, ROW 28%), and synergy realization — remain unverifiable from reported financials.",
      "source_ids": [
       "T:2026-05-01:p7",
       "T:2026-05-01:p8",
       "T:2026-05-01:p9"
      ]
     },
     {
      "text": "Free cash flow guidance of $2–2.5 billion annually lacks verification, and ROE is not available, limiting return-on-equity assessment.",
      "source_ids": [
       "T:2026-05-01:p9",
       "SCR"
      ]
     }
    ]
