   "data": {
    "bull": [
     {
      "text": "The company has delivered consistent profitable growth with 10% revenue CAGR and 10.6% PAT CAGR over three years, while expanding operating margin to 28.2% from 26.5% three years ago.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Balance sheet strength is evident with minimal leverage (debt-to-equity 0.04) and strong cash conversion (operating cash flow/PAT of 1.2x over three years).",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Management targets combined revenue of $12.4 billion and $350 million in cost synergies over 2-4 years, with the combined entity generating $2-2.5 billion annual free cash flow.",
      "source_ids": [
       "T:2026-05-01:p7",
       "T:2026-05-01:p9"
      ]
     }
    ],
    "bear": [
     {
      "text": "Quarterly profitability has deteriorated sharply, with PAT falling from ₹3,381 Cr in Dec 2025 to ₹1,995 Cr in Sep 2026 despite revenue holding above ₹14,600 Cr.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The effective tax rate remains elevated at 27.8% and is expected to stay in that range until the Organon transaction completes, creating uncertainty.",
      "source_ids": [
       "T:2026-08-01:p17"
      ]
     },
     {
      "text": "Key strategic targets (innovative mix 26-27%, US 27% of sales, biosimilars 6%) are unverified as management guidance has not yet been reflected in reported financials.",
      "source_ids": [
       "T:2026-05-01:p8"
      ]
     }
    ]
