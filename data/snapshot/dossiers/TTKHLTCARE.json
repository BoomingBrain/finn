   "data": {
    "bull": [
     {
      "text": "The company operates a diversified portfolio across six segments with the largest (Male Contraceptives) contributing only 25.26% of revenue, reducing single-segment concentration risk.",
      "source_ids": [
       "AR:2026:p45"
      ]
     },
     {
      "text": "The balance sheet is nearly debt-free with a debt-to-equity ratio of just 0.02, providing financial flexibility.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Quarterly revenue has grown sequentially from ₹204 Cr in Sep 2025 to ₹258 Cr in Jun 2026, a 26% increase over three quarters.",
      "source_ids": [
       "SCR"
      ]
     }
    ],
    "bear": [
     {
      "text": "Despite a 5.7% revenue CAGR over three years, PAT has collapsed at a -53.1% CAGR, signaling severe margin erosion.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Operating cash flow has been negative relative to PAT over three years (ratio -0.14), with the screener flagging 'Profits not converting to cash'.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Operating margin has fallen from 4.3% to 3% and ROCE stands at only 8%, indicating deteriorating profitability and capital efficiency.",
      "source_ids": [
       "SCR"
      ]
     }
    ]
