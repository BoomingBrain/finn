   "data": {
    "bull": [
     {
      "text": "CDSL delivered strong 3-year CAGR of 27.3% in revenue and 18.1% in PAT, reaching TTM revenue of ₹1,179 Cr and PAT of ₹471 Cr.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "The company maintains high profitability with 50.8% operating margin, 32% ROCE, zero debt (debt-to-equity 0.0), and operating cash flow equal to PAT over three years.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "As India's leading Market Infrastructure Institution, CDSL derives 80% of revenue from depository services, providing a dominant market position in dematerialization and settlement of securities.",
      "source_ids": [
       "AR:2026:p16",
       "AR:2026:p18"
      ]
     }
    ],
    "bear": [
     {
      "text": "Operating margin has compressed from 57.5% three years ago to 50.8% currently, signaling potential pricing pressure or cost increases.",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Quarterly PAT shows volatility and a declining trend: ₹140 Cr (Sep 2025), ₹133 Cr (Dec 2025), ₹80 Cr (Mar 2026), ₹118 Cr (Jun 2026).",
      "source_ids": [
       "SCR"
      ]
     },
     {
      "text": "Revenue concentration risk is high with 80% dependent on depository services, exposing the business to regulatory or market structure changes in a single segment.",
      "source_ids": [
       "AR:2026:p16",
       "AR:2026:p18"
      ]
     }
