# Copy to .env (never committed). Only NVIDIA_API_KEY is needed to run ingest and research locally.
NVIDIA_API_KEY=
# Optional: a free Google AI Studio key. Used only when NVIDIA fails after its retries.
GEMINI_API_KEY=
# Deploy only: Hugging Face token with write access, the Space id (user/space) and the Render service URL.
HF_TOKEN=
HF_SPACE=
RENDER_URL=
